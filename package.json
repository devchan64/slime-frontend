{
  "name": "slime-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:map-assets && npm run check:sprite-assets && npm run check:images && npm run check:i18n && tsc -b && vite build",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-locales.mjs",
    "check:images": "node scripts/check-images.mjs",
    "build:review": "bash scripts/build_ui_review.sh",
    "check:map-assets": "node scripts/prepare-map-assets.mjs --check && node scripts/check-map-assets.mjs",
    "prepare:map-assets": "node scripts/prepare-map-assets.mjs",
    "predev": "npm run prepare:map-assets && npm run prepare:sprite-assets && npm run check:ui-assets",
    "prebuild": "npm run prepare:map-assets && npm run prepare:sprite-assets && npm run check:ui-assets",
    "prepare:sprite-assets": "node scripts/prepare-map-assets.mjs --sprites",
    "check:sprite-assets": "node scripts/prepare-map-assets.mjs --sprites --check && node scripts/check-map-assets.mjs --sprites",
    "check:ui-assets": "node scripts/prepare-map-assets.mjs --ui --check && node scripts/check-map-assets.mjs --ui",
    "build:verified": "bash scripts/verify_production_build.sh",
    "check:production-browser": "node scripts/check-production-browser.mjs",
    "build:docker:verified": "bash scripts/verify_docker_build.sh"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "preact": "^10.26.4",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vite": "5.4.19"
  },
  "license": "MIT"
}
